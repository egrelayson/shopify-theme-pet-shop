<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>
      {{ page_title }}
      {% if current_tags %} – {{ current_tags | join: ', ' }}{% endif %}
      {% if current_page != 1 %} – Page {{ current_page }}{% endif %}
      {% unless page_title contains shop.name %} – {{ shop.name }}{% endunless %}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {{ content_for_header }}

    {%- comment -%} Theme base styles (your overrides) {%- endcomment -%}
    {{ 'base.css' | asset_url | stylesheet_tag }}

    {%- comment -%} Bootstrap CSS (CDN for MVP) {%- endcomment -%}
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-..."
      crossorigin="anonymous"
    >
  </head>

  <body class="template-{{ template.name }}">

    <a class="visually-hidden-focusable skip-link" href="#MainContent">
      Skip to content
    </a>

    {% section 'header' %}

    <main id="MainContent" role="main" class="flex-grow-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    {%- comment -%} Bootstrap JS bundle {%- endcomment -%}
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-..."
      crossorigin="anonymous"
      defer
    ></script>
  </body>
</html>
