{% comment %}
  Enhanced List Collections with Bootstrap 5
  Renders all store collections in a responsive card grid.
{% endcomment %}

<section class="collections-list-section py-5">
  <div class="container">
    
    <!-- Section Header -->
    <header class="text-center mb-5">
      <h1 class="display-5 fw-bold">{{ 'collections.title' | t }}</h1>
      <p class="text-muted">Explore our curated selections for your pets</p>
    </header>

    <!-- Collections Grid -->
    <div class="row g-{{ section.settings.grid_gap_mobile }} g-lg-{{ section.settings.grid_gap_desktop }}">
      {% for collection in collections %}
        <div class="col-sm-6 {{ section.settings.grid_item_width }}">
          <a href="{{ collection.url }}" class="card h-100 shadow-sm text-decoration-none border-0 transition-hover">
            
            <!-- Collection Image with 1:1 Aspect Ratio -->
            <div class="ratio ratio-1x1 overflow-hidden">
              {% if collection.featured_image %}
                {{ collection.featured_image | image_url: width: 600 | image_tag: 
                  class: 'card-img-top object-fit-cover', 
                  loading: 'lazy', 
                  alt: collection.title 
                }}
              {% else %}
                {{ 'collection-1' | placeholder_svg_tag: 'card-img-top bg-light' }}
              {% endif %}
            </div>

            <!-- Card Body -->
            <div class="card-body text-center d-flex flex-column justify-content-center">
              <h3 class="h5 card-title fw-bold text-dark mb-2">{{ collection.title }}</h3>
              
              {% if collection.description != blank %}
                <p class="card-text text-secondary small px-2">
                  {{ collection.description | strip_html | truncatewords: 12 }}
                </p>
              {% endif %}
              
              <span class="btn btn-outline-primary btn-sm mt-3 align-self-center">
                View Collection
              </span>
            </div>
          </a>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .transition-hover {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .transition-hover:hover {
    transform: translateY(-5px);
    box-shadow: 0 1rem 3rem rgba(0,0,0,.175) !important;
  }
  .object-fit-cover {
    object-fit: cover;
  }
</style>

{% schema %}
{
  "name": "Collections Grid",
  "settings": [
    {
      "type": "select",
      "id": "grid_item_width",
      "label": "Desktop Columns",
      "options": [
        { "value": "col-lg-4", "label": "3 Columns" },
        { "value": "col-lg-3", "label": "4 Columns" }
      ],
      "default": "col-lg-4"
    },
    {
      "type": "range",
      "id": "grid_gap_desktop",
      "label": "Desktop Gap",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "grid_gap_mobile",
      "label": "Mobile Gap",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 3
    }
  ],
  "presets": [{ "name": "Collections Grid" }]
}
{% endschema %}
