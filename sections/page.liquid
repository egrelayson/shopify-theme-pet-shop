{% comment %}
  This section is used in the page template to render store pages like About us
  or Contact us.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/page
{% endcomment %}

{% comment %}
  Enhanced Page Template with Bootstrap 5
  Wraps page title and content in a responsive container.
{% endcomment %}

<section class="page-section py-5">
  <div class="{% if section.settings.full_width %}container-fluid{% else %}container{% endif %}">
    <div class="row justify-content-center">
      <div class="col-12 col-lg-10 col-xl-8">
        
        <!-- Page Title -->
        <header class="page-header mb-4 border-bottom">
          <h1 class="display-4 fw-bold">{{ page.title }}</h1>
        </header>

        <!-- Page Content -->
        <div class="page-content entry-content fs-5 text-secondary">
          {{ page.content }}
        </div>
        
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:general.page",
  "settings": []
}
{% endschema %}
