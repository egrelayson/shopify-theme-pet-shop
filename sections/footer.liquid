<footer class="site-footer py-4 border-top">
  <div class="container">
    <div class="row align-items-center text-center text-md-start">

      <!-- Copyright -->
      <div class="col-md-6 mb-3 mb-md-0">
        <p class="site-footer__copyright mb-0">
          &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
        </p>
      </div>

      <!-- Footer navigation -->
      <div class="col-md-6">
        {% if linklists.footer-menu.links.size > 0 %}
          <ul class="site-footer__nav list-unstyled d-flex justify-content-center justify-content-md-end mb-0 gap-3">
            {% for link in linklists.footer-menu.links %}
              <li>
                <a href="{{ link.url }}" class="site-footer__link">
                  {{ link.title }}
                </a>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>

    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}
